[Unit]
Description=ServiceManager (Docker stack - PostgreSQL)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/servicemenager
ExecStart=/usr/bin/docker compose -f /opt/servicemenager/docker-compose.yml up -d
ExecStop=/usr/bin/docker compose -f /opt/servicemenager/docker-compose.yml down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
